#!/usr/bin/env bash
# Switch to a worktrunk worktree, creating it if needed.
#
#   wt-open <branch>             wt switch <branch>
#   wt-open --create [<base>]    prompt for a name, then wt switch --create <name> [--base <base>]
#
# Inside tmux the worktree is opened in its own tmux session (named like the
# post-start hook in ~/.config/worktrunk/config.toml); outside tmux a $SHELL is
# started in the worktree.
set -euo pipefail

args=()
if [ "${1:-}" = "--create" ]; then
  base=${2:-}
  read -r -e -p "New branch${base:+ (from $base)}: " branch
  [ -n "$branch" ] || exit 0
  args=(--create)
  [ -n "$base" ] && args+=(--base "$base")
else
  branch=$1
fi

if [ -z "${TMUX:-}" ]; then
  exec wt switch --yes --no-cd ${args[@]+"${args[@]}"} "$branch" -x "${SHELL:-zsh}"
fi

wt switch --yes --no-cd ${args[@]+"${args[@]}"} "$branch"

path=$(git worktree list --porcelain |
  awk -v ref="refs/heads/$branch" '/^worktree /{wt=substr($0, 10)} $1=="branch" && $2==ref {print wt}')
[ -n "$path" ] || { echo "wt-open: no worktree found for $branch" >&2; exit 1; }

session=$(basename "$path" | tr '.:' '__')
# The worktrunk post-start hook may be creating the same session concurrently.
tmux has-session -t "=$session" 2>/dev/null || tmux new-session -d -s "$session" -c "$path" || true
tmux switch-client -t "=$session"
