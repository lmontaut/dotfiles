#!/usr/bin/env bash
# Switch to a worktrunk worktree, creating it if needed.
#
#   wt-open <branch>             wt switch <branch>
#   wt-open --create [<base>]    prompt for a name, then wt switch --create <name> [--base <base>]
#
# Inside tmux, the worktrunk post-switch hook opens the worktree in its own tmux
# session; outside tmux a $SHELL is started in the worktree.
set -euo pipefail

args=()
if [ "${1:-}" = "--create" ]; then
  base=${2:-}
  read -r -e -p "New branch${base:+ (from $base)}: " branch
  [ -n "$branch" ] || exit 0
  args=(--create)
  [ -n "$base" ] && args+=(--base "$base")
else
  branch=$1
fi

if [ -z "${TMUX:-}" ]; then
  exec wt switch --yes --no-cd ${args[@]+"${args[@]}"} "$branch" -x "${SHELL:-zsh}"
fi

# The worktrunk post-switch hook opens/creates the worktree's tmux session
# (and checks out submodules there), see ~/.config/worktrunk/config.toml
exec wt switch --yes --no-cd ${args[@]+"${args[@]}"} "$branch"
