# Over ssh (e.g. a cluster), use the agent forwarded from the desktop instead of
# starting a new one (oh-my-zsh ssh-agent plugin, loaded in ~/.zshrc_common)
zstyle :omz:plugins:ssh-agent agent-forwarding yes

# The forwarded agent socket changes at every ssh login, so shells in a tmux
# session started by an earlier login lose it: point everyone at a stable
# symlink, refreshed by each new login shell outside tmux.
if [ -n "$SSH_CONNECTION" ]; then
  if [ -z "$TMUX" ] && [ -S "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$HOME/.ssh/agent.sock" ]; then
    ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/agent.sock"
  fi
  [ -S "$HOME/.ssh/agent.sock" ] && export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
fi

# Shared config, found next to this file's real location in the dotfiles
# (%x: this file, :A resolves the ~/.zshrc_config symlink)
source ${${(%):-%x}:A:h:h:h}/zsh/.zshrc_common

# -------- Linux only --------
alias open="xdg-open"

# X11 desktop only (no display over ssh)
if [ -n "$DISPLAY" ]; then
  alias lum05="xrandr --output eDP --brightness 0.5"
  alias lum10="xrandr --output eDP --brightness 1.0"
  alias lum15="xrandr --output eDP --brightness 1.5"
  alias lum="xrandr --output eDP --brightness"
  xset r rate 300 50 2>/dev/null
fi

# Clang compiler
# export CXX="/usr/bin/ccache /usr/bin/clang++"
# export CC="/usr/bin/ccache /usr/bin/clang"
